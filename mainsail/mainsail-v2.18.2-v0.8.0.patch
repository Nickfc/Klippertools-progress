+.registry-value span,
+.usage-grid span {
+    color: rgba(127, 127, 127, 0.9);
+    font-size: 0.72rem;
+}
+
+.usage-grid {
+    display: grid;
+    gap: 8px;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+}
+</style>
