+                                suffix="mm"
+                                outlined
+                                dense />
+                        </v-col>
+                        <v-col cols="12" sm="6">
+                            <v-text-field v-model="draft.material" label="Tool material" outlined dense />
+                        </v-col>
+                    </v-row>
+                    <v-text-field
+                        v-model.number="draft.max_temp"
+                        type="number"
+                        min="1"
+                        max="600"
+                        label="Optional maximum temperature"
+                        suffix="°C"
+                        outlined
+                        dense />
